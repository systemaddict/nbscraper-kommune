# MCP server — the same FTS5 article search as the dashboard, exposed to MCP
# clients that support a configured bearer credential over authenticated HTTP.

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
COPY nbkommune ./nbkommune
RUN pip install --no-cache-dir -e ".[mcp]"

RUN groupadd --gid 1001 app && useradd --uid 1001 --gid 1001 -m app
USER app

ENV PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8

EXPOSE 8766

# HTTP mode refuses to start unless NBK_MCP_AUTH_TOKENS is configured.
CMD ["nbk", "mcp", "--http", "--host", "0.0.0.0", "--port", "8766"]

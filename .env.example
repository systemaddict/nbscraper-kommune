# ── Database ────────────────────────────────────────────────────────────────
# Bunny injects these credentials when the database is attached to the Magic
# Container app. For local development, `file:./nbkommune.db` also works.
BUNNY_DATABASE_URL=libsql://your-database-id.lite.bunnydb.net/
BUNNY_DATABASE_AUTH_TOKEN=
NBK_DATABASE_TIMEOUT_S=30

# ── Dashboard access ───────────────────────────────────────────────────────
# The worker ignores this. Leave true on the dashboard container; false is an
# explicit local-only bypass for diagnostics.
NBK_AUTH_ENABLED=true
NBK_AUTH_BASE_URL=https://your-dashboard.example.com
# Generate with: openssl rand -base64 32
NBK_AUTH_SECRET=
# The first dashboard start creates this user if no auth user exists. Public
# signup stays disabled. Remove these two values after the first successful login.
NBK_AUTH_BOOTSTRAP_EMAIL=
NBK_AUTH_BOOTSTRAP_PASSWORD=
# FastAPI only listens on this loopback port behind the auth gateway.
NBK_AUTH_INTERNAL_PORT=8001

# ── Gmail inbox ───────────────────────────────────────────────────────────────
# Requires a Gmail OAuth refresh token granted read-only Gmail access. Keep
# these values on the worker container only. The OpenRouter key may reuse the
# same deployment secret value as the main nbscraper project.
NBK_GMAIL_ENABLED=false
NBK_GMAIL_CLIENT_ID=
NBK_GMAIL_CLIENT_SECRET=
NBK_GMAIL_REFRESH_TOKEN=
# Prefer a dedicated label so personal correspondence never enters the pipeline.
NBK_GMAIL_QUERY=label:kommune-news
NBK_GMAIL_POLL_INTERVAL_MIN=5
# Process at most this many unknown/error messages per poll, while scanning past
# already-known recent messages to let an initial backlog drain.
NBK_GMAIL_BATCH_SIZE=100
NBK_GMAIL_SCAN_LIMIT=2000
NBK_GMAIL_AI_BODY_CHARS=12000
NBK_OPENROUTER_API_KEY=
NBK_OPENROUTER_MODEL=openai/gpt-4o-mini
NBK_OPENROUTER_TIMEOUT_S=45
NBK_EMAIL_AI_CONFIDENCE=0.85

# ── Targets ─────────────────────────────────────────────────────────────────
# Comma-separated kommune keys to crawl. Empty = all enabled targets in the
# registry. Naming an explicit key overrides its `enabled: false` flag.
NBK_TARGETS=
# Optional JSON file with per-site overrides (selectors, channel, URLs). Same
# shape as nbkommune/registry.json; entries merge into the built-in.
NBK_TARGETS_FILE=./config/targets.json
# Never store an article published before this date. Sitemaps happily expose a
# decade of archive, so without a floor the first crawl pulls all of it.
# Articles with no parseable date are KEPT (fail open).
NBK_MIN_PUBLISHED_DATE=2026-01-01

# ── HTTP / politeness ───────────────────────────────────────────────────────
# The `Mozilla/5.0 (compatible; …)` prefix is required, and the tokens "bot" and
# "scraper" are refused by some of these WAFs — see nbkommune/settings.py.
NBK_USER_AGENT=Mozilla/5.0 (compatible; nbmedier-nyheder/0.1; +https://nbmedier.dk)
# Tried in order when a host refuses the primary UA. Comma-separated.
NBK_USER_AGENT_FALLBACKS=Mozilla/5.0 (compatible; nbmedier/0.1; +https://nbmedier.dk)
# Seconds between consecutive requests to the same host.
NBK_SCRAPE_MIN_INTERVAL_S=2.0
NBK_HTTP_TIMEOUT_S=30.0
NBK_HTTP_CONNECT_TIMEOUT_S=8.0
NBK_HTTP_MAX_RETRIES=3
NBK_MAX_RESPONSE_BYTES=25000000
# Honour robots.txt. Leave on.
NBK_RESPECT_ROBOTS=true
NBK_ROBOTS_TTL_S=86400

# ── scrape.do proxy (Cloudflare / WAF bypass) ───────────────────────────────
# Empty token = no proxying at all. Gentofte currently 403s a datacenter IP.
NBK_SCRAPEDO_TOKEN=
NBK_SCRAPEDO_HOSTS=
NBK_SCRAPEDO_FALLBACK_HOSTS=
NBK_SCRAPEDO_FALLBACK_TTL_S=1800
NBK_SCRAPEDO_AUTO_CLOUDFLARE=true

# ── Scheduling ──────────────────────────────────────────────────────────────
NBK_DISCOVER_INTERVAL_MIN=120
NBK_PACED_TASK_INTERVAL_S=10
NBK_TASK_LEASE_MIN=15
NBK_TASK_BACKOFF_BASE_S=60
NBK_TASK_BACKOFF_MAX_S=21600
NBK_TASK_RETENTION_DAYS=14
NBK_RECHECK_SETTLE_DAYS=7
NBK_RECHECK_INTERVAL_DAYS=2
# Max articles one discovery pass may enqueue per target; the rest stay
# 'listed' and are picked up by `nbk backfill`.
NBK_DISCOVER_ENQUEUE_CAP=50

# ── Extraction ──────────────────────────────────────────────────────────────
# Bodies shorter than this are stored but flagged `thin` (see `nbk stats`).
NBK_MIN_BODY_CHARS=200

# Hosts fetched through the proxy WITH JS rendering. Doubles latency and costs
# more per request, so opt in per host. Verify with `nbk resolve` first —
# rendering alone does not crack a list populated by a later XHR.
NBK_SCRAPEDO_RENDER_HOSTS=
# Read timeout for proxied requests (they legitimately take longer than direct).
NBK_SCRAPEDO_TIMEOUT_S=90
# Escalate a host to the proxy when it refuses every identifier (401/403/451, or
# a WAF answering 200 with a refusal body). Gentofte needs this.
NBK_SCRAPEDO_AUTO_REFUSAL=true

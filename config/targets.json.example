[
  {
    "_comment": "Overrides merge over nbkommune/registry.json by key. Only the fields you set change; everything else is inherited. This is where a site fix goes — no code change.",
    "key": "skanderborg",
    "channel": "listing",
    "config": {
      "item_selector": "article.teaser",
      "link_selector": "a",
      "title_selector": "h3",
      "date_selector": "time",
      "body_selector": ".body-wrapper"
    }
  },
  {
    "key": "fredericia",
    "channel": "feed",
    "config": { "feed_url": "https://www.fredericia.dk/da/rss.xml" }
  },
  {
    "key": "jammerbugt",
    "channel": "sitemap",
    "config": { "sitemap_url": "https://www.jammerbugt.dk/sitemap.xml", "url_prefix": "/nyheder" }
  }
]
